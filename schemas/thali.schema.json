{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macrokatori.app/schemas/thali.schema.json",
  "title": "Thali",
  "description": "A composed meal made of references to individual food records, each with a chosen portion. Totals are computed by tooling from the component foods, so they are not hand-stored (kept optional as a cache).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "region", "components", "lastReviewed"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "localNames": { "type": "object", "additionalProperties": { "type": "string" } },
    "region": {
      "type": "string",
      "enum": ["east", "north-east", "south", "north", "west", "central", "himalayan", "pan-india"]
    },
    "state": { "type": "string" },
    "dietType": { "type": "string", "enum": ["veg", "non-veg", "egg"] },
    "description": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Each entry points to a food by id and the serving used in this thali.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["foodId", "unit", "quantity"],
        "properties": {
          "foodId": { "type": "string", "description": "id of a food record." },
          "unit": { "type": "string", "description": "Portion unit code used for this component." },
          "quantity": { "type": "number", "exclusiveMinimum": 0, "description": "Number of units." },
          "oilStyle": { "type": "string", "enum": ["very_light", "home_style", "medium", "heavy", "dhaba"], "description": "Oil style for this component; defaults to home_style." },
          "optional": { "type": "boolean", "description": "Whether the diner can drop this item." }
        }
      }
    },
    "computedTotals": {
      "type": "object",
      "description": "Optional cache of summed macros at default oil styles; regenerated by tools/build-index.js.",
      "additionalProperties": false,
      "properties": {
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" }
      }
    },
    "mealTags": { "type": "array", "items": { "type": "string" } },
    "healthTags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "source": { "type": "string" },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
