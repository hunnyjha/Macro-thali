{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macrokatori.app/schemas/food.schema.json",
  "title": "Food",
  "description": "A single food/dish record. All macros are per 100g of the edible portion, measured at the base oil style (home_style). Region files are arrays of these records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "region",
    "state",
    "category",
    "dietType",
    "per100g",
    "portions",
    "oilSensitivity",
    "mealTags",
    "proteinScore",
    "confidence",
    "source",
    "lastReviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Globally unique stable slug, kebab-case. Convention: <state>-<short-name>, e.g. 'bihar-litti-chokha'. Pan-india items use 'pi-' prefix."
    },
    "name": { "type": "string", "minLength": 1, "description": "Primary English/transliterated name." },
    "localNames": {
      "type": "object",
      "description": "Names keyed by ISO-ish language code (hi, bn, ta, te, ...). Optional.",
      "additionalProperties": { "type": "string" }
    },
    "aliases": {
      "type": "array",
      "description": "Alternate spellings/common names used to improve search.",
      "items": { "type": "string" }
    },
    "region": {
      "type": "string",
      "enum": ["east", "north-east", "south", "north", "west", "central", "himalayan", "pan-india"],
      "description": "Broad zone (matches regions.json zones)."
    },
    "state": {
      "type": "string",
      "description": "State code from regions.json (e.g. 'bihar'), or 'pan-india'."
    },
    "category": { "type": "string", "description": "Category code from categories.json." },
    "subcategory": { "type": "string", "description": "Subcategory code from categories.json. Optional." },
    "dietType": {
      "type": "string",
      "enum": ["veg", "non-veg", "egg"],
      "description": "veg | non-veg | egg (egg-but-no-meat)."
    },
    "per100g": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calories", "protein", "carbs", "fat"],
      "description": "Macros per 100 g at base oil style (home_style).",
      "properties": {
        "calories": { "type": "number", "minimum": 0 },
        "protein": { "type": "number", "minimum": 0 },
        "carbs": { "type": "number", "minimum": 0 },
        "fat": { "type": "number", "minimum": 0 },
        "fiber": { "type": "number", "minimum": 0, "description": "Optional; include when available." }
      }
    },
    "portions": {
      "type": "array",
      "minItems": 1,
      "description": "Indian-first portion mappings. Each maps a unit code (from portions.json) to its exact gram weight for THIS food.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "grams"],
        "properties": {
          "unit": { "type": "string", "description": "Unit code from portions.json." },
          "grams": { "type": "number", "exclusiveMinimum": 0 },
          "label": { "type": "string", "description": "Optional display override, e.g. '1 medium katori'." },
          "default": { "type": "boolean", "description": "Marks the default serving shown in UI." }
        }
      }
    },
    "oilSensitivity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "fried"],
      "description": "Maps to oil-modifiers.json sensitivityLevels."
    },
    "oilModifiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-food override of oil grams per 100g by style. If absent, the oilSensitivity defaults from oil-modifiers.json are used.",
      "properties": {
        "very_light": { "type": "number" },
        "home_style": { "type": "number" },
        "medium": { "type": "number" },
        "heavy": { "type": "number" },
        "dhaba": { "type": "number" }
      }
    },
    "mealTags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Meal tag codes from tags.json."
    },
    "healthTags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Health tag codes from tags.json. May be auto-derived by tooling."
    },
    "proteinScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "0-10 protein quality+density score. See docs/SCORING.md. Auto-computable from per100g."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Data confidence level (see confidence-and-sources.json)."
    },
    "source": {
      "type": "string",
      "enum": ["ICMR", "NIN", "IFCT", "FSSAI", "USDA", "published-database", "recipe-analysis", "restaurant-menu", "brand-label", "community-estimate", "user-created"],
      "description": "Source reference code."
    },
    "sourceNote": { "type": "string", "description": "Optional free-text citation detail (table number, URL, recipe origin)." },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD) the record was last reviewed."
    }
  }
}
